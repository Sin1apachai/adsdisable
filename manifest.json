{
  "manifest_version": 3,
  "name": "X Ads — ปิดโฆษณา",
  "version": "1.7.1",
  "description": "บล็อกแหล่งโฆษณาทั่วไป พร้อมยกเว้นเว็บไซต์และเปิด–ปิดได้ ไม่มีการส่งข้อมูลออก",
  "permissions": ["declarativeNetRequest", "storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "X Ads", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "declarative_net_request": { "rule_resources": [{ "id": "ads", "enabled": true, "path": "rules.json" }] },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start" },
    { "matches": ["https://lumierecore.com/*"], "js": ["player-policy.js"], "world": "MAIN", "all_frames": true, "run_at": "document_start" },
    { "matches": ["https://lumierecore.com/*"], "js": ["player-ads.js"], "all_frames": true, "run_at": "document_start" }
  ]
}
