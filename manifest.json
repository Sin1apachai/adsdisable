{
  "manifest_version": 3,
  "name": "ClearAds — ปิดโฆษณา",
  "version": "1.4.1",
  "description": "บล็อกแหล่งโฆษณาทั่วไป พร้อมยกเว้นเว็บไซต์และเปิด–ปิดได้ ไม่มีการส่งข้อมูลออก",
  "permissions": ["declarativeNetRequest", "storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "ClearAds" },
  "declarative_net_request": { "rule_resources": [{ "id": "ads", "enabled": true, "path": "rules.json" }] },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start" }]
}
